// LOCAL DEV ONLY (generated from wrangler.jsonc minus the remote-only AI binding). `npm run dev` uses this so nothing leaves your machine.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okanary-dev",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okanary",
      // Replace with the id printed by `npx wrangler d1 create okanary`. Local dev works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Hourly: promote stale pending Apple Pay items, email-silence alerts, FX refresh, push outbox flush, net worth price retries (07:00-12:00 SGT), monthly summary (1st, 09:00 SGT). 06:30 SGT: net worth prices + daily snapshot. Daily 02:00 SGT: recurring detection. Sunday 20:00 SGT: weekly digest.
  "triggers": { "crons": ["0 * * * *", "0 18 * * *", "0 12 * * SUN", "30 22 * * *"] },
  "observability": { "enabled": true }
}
