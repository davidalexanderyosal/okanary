{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okanary",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okanary",
      // Replace with the id printed by `npx wrangler d1 create okanary`. Local dev works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Workers AI: category suggestions + email-parse fallback. Always remote; local dev uses wrangler.dev.jsonc (no AI binding).
  "ai": { "binding": "AI" },
  // Hourly: promote stale pending Apple Pay items, email-silence health alerts (later phases add daily/weekly dispatch on the cron string)
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
