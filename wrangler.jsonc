{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okanary",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okanary",
      // Created in your Cloudflare account (APAC); migrations 0001-0003 already applied remotely.
      "database_id": "a3e2fb0b-e124-442f-9260-331f73eba9ae",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Workers AI: category suggestions + email-parse fallback. Always remote; local dev uses wrangler.dev.jsonc (no AI binding).
  "ai": { "binding": "AI" },
  // Hourly: promote stale pending Apple Pay items, email-silence alerts, FX refresh, push outbox flush, net worth price retries (07:00-12:00 SGT), monthly summary (1st, 09:00 SGT). 06:30 SGT: net worth prices + daily snapshot. Daily 02:00 SGT: recurring detection. Sunday 20:00 SGT: weekly digest.
  "triggers": { "crons": ["0 * * * *", "0 18 * * *", "0 12 * * 0", "30 22 * * *"] },
  "observability": { "enabled": true }
}
